{
  "name": "fluenttube-ai",
  "version": "0.1.0",
  "private": true,
  "description": "FluentTube AI - YouTube English dictation & shadowing web app with local speech recognition",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "backend\\.venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "backend\\.venv\\Scripts\\pytest.exe backend/tests",
    "test": "npm run test:backend && npm run test:frontend",
    "check-env": "backend\\.venv\\Scripts\\python.exe backend/check_environment.py"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
