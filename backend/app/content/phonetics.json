        "lips": "spread"
      },
      "version": "2"
    },
    {
      "id": "palm",
      "ipa": "ɑː",
      "word": "cart",
      "name": "Vowel · PALM",
      "guide_es": "Abre la boca y deja la lengua baja y posterior. En esta referencia no rótica, cart no lleva una r antes de la t.",
      "contrast_id": "strut",
      "contrast_word": "cut",
      "diagram": {
