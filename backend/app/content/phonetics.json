      },
      "version": "2"
    },
    {
      "id": "trap",
      "ipa": "æ",
      "word": "bad",
      "name": "Vowel · TRAP",
      "guide_es": "Abre más la mandíbula que para bed. Mantén la parte alta de la lengua hacia delante al decir bad.",
      "contrast_id": "dress",
      "contrast_word": "bed",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.1,
            0.85
