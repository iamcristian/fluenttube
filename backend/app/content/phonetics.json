    {
      "id": "fleece",
      "ipa": "iː",
      "word": "sheep",
      "name": "Vowel · FLEECE",
      "guide_es": "Eleva la parte delantera de la lengua hacia el paladar. Deja los labios sin redondear; compara sheep con ship.",
      "contrast_id": "kit",
      "contrast_word": "ship",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.06,
            0.05
          ]
        ],
        "lips": "spread"
      },
      "version": "2"
    },
    {
      "id": "kit",
      "ipa": "ɪ",
      "word": "ship",
      "name": "Vowel · KIT",
      "guide_es": "Desde /iː/, baja y retrasa un poco la lengua. Mantén la mandíbula suelta; escucha la vocal de ship.",
      "contrast_id": "fleece",
      "contrast_word": "sheep",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.2,
            0.22
          ]
        ],
        "lips": "relaxed"
      },
      "version": "2"
    },
    {
      "id": "dress",
      "ipa": "e",
      "word": "bed",
      "name": "Vowel · DRESS",
      "guide_es": "Abre la mandíbula a media altura. Deja la lengua delante y escucha la vocal breve de bed.",
      "contrast_id": "trap",
      "contrast_word": "bad",
      "diagram": {
        "kind": "vowel",
        "points": [
