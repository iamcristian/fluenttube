        "points": [
          [
            0.83,
            0.96
          ]
        ],
        "lips": "relaxed"
      },
      "version": "2"
    },
    {
      "id": "lot",
      "ipa": "ɒ",
      "word": "cot",
      "name": "Vowel · LOT",
      "guide_es": "Redondea suavemente los labios y baja la lengua hacia atrás. Contrasta cot con caught.",
      "contrast_id": "thought",
      "contrast_word": "caught",
      "diagram": {
